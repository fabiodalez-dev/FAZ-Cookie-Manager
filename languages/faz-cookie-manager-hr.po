msgstr "Obrišete sve kolačiće pri zatvaranju preglednika"

#: includes/class-cookie-policy-shortcode.php:104
msgid "Please note that if you disable cookies, some features of this website may not function properly."
msgstr "Imajte na umu da ako onemogućite kolačiće, neke funkcije ove web-stranice možda neće ispravno raditi."

