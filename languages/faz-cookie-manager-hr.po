#. translators: %d: total number of pages to scan
#: admin/class-admin.php:549
#, php-format
msgid "Scanning 0/%d pages..."
msgstr "Skeniranje 0/%d stranica..."

#: admin/class-admin.php:550
msgid "e.g. custom-tracker.com/script.js"
msgstr "npr. custom-tracker.com/script.js"

#. translators: %1$d: number of rules added, %2$s: template name
#: admin/class-admin.php:552
#, php-format
msgid "Added %1$d rules from %2$s (saved)"
msgstr "Dodano %1$d pravila iz %2$s (spremljeno)"

#. translators: %s: template name
#: admin/class-admin.php:554
#, php-format
msgid "All cookies from %s already exist"
msgstr "Svi kolačići od %s već postoje"

#: admin/class-admin.php:555 includes/class-cookie-table-shortcode.php:297
msgid "No cookies found."
msgstr "Nema pronađenih kolačića."

#: admin/class-admin.php:556
msgid "Edit"
msgstr "Uredi"

#: admin/class-admin.php:557 admin/class-admin.php:888
msgid "Delete"
msgstr "Izbriši"

#: admin/class-admin.php:558
msgid "Delete stale"
msgstr "Izbriši zastarjele"

#: admin/class-admin.php:559 admin/views/cookies.php:235
#: admin/views/system-status.php:131
#: includes/class-cookie-table-shortcode.php:229
msgid "Category"
msgstr "Kategorija"

#: admin/class-admin.php:560
msgid "Cancel"
msgstr "Odustani"

#: admin/class-admin.php:561
msgid "Cookie updated."
msgstr "Kolačić ažuriran."

#: admin/class-admin.php:562
msgid "Cookie added."
msgstr "Kolačić dodan."

#: admin/class-admin.php:563
msgid "Failed to save cookie."
msgstr "Spremanje kolačića nije uspjelo."

#. translators: %s: cookie name
#: admin/class-admin.php:565
#, php-format
msgid "Delete cookie \"%s\"?"
msgstr "Izbrisati kolačić \"%s\"?"

#: admin/class-admin.php:566
msgid "Cookie deleted."
msgstr "Kolačić obrisan."

#: admin/class-admin.php:567
msgid "Failed to delete cookie."
msgstr "Brisanje kolačića nije uspjelo."

#: admin/class-admin.php:568
msgid "Stale cookie deleted."
msgstr "Zastarjeli kolačić izbrisan."

#: admin/class-admin.php:569
msgid "Failed to delete stale cookie."
msgstr "Brisanje zastarjelog kolačića nije uspjelo."

#: admin/class-admin.php:571
msgid "Select a service…"
msgstr "Odaberite uslugu…"

#: admin/class-admin.php:572
msgid "Could not load services"
msgstr "Nije moguće učitati usluge"

#. translators: 1: service label, 2: number of cookies registered.
#: admin/class-admin.php:574
#, php-format
msgid "%1$s: %2$d cookie(s) registered"
msgstr "%1$s: registrirano je %2$d kolačića"

#: admin/class-admin.php:575
msgid "Could not register service."
msgstr "Nije moguće registrirati uslugu."

#: admin/class-admin.php:576
msgid "Remove these cookie-policy entries? Cookies that load only after an interaction, during a flow, or as httpOnly cookies may still be present even if the scan did not observe them."
msgstr "Ukloniti ove unose iz pravila o kolačićima? Kolačići koji se učitavaju samo nakon interakcije, tijekom određenog procesa ili kao httpOnly kolačići mogu i dalje postojati čak i ako ih skeniranje nije uočilo."

#: admin/class-admin.php:577
msgid "No stale cookies to delete."
msgstr "Nema zastarjelih kolačića za brisanje."

#. translators: %d: number of entries the server kept because they have not yet been missing from enough consecutive complete scans.
#: admin/class-admin.php:579
#, php-format
msgid "%d entry(ies) were kept: they have not yet been missing from enough complete scans."
msgstr "Zadržano je %d unosa: još nisu izostajali iz dovoljnog broja potpunih skeniranja."

#: admin/class-admin.php:581
msgid "Undo delete"
msgstr "Poništi brisanje"

#. translators: %d: number of cookies in the most recent deleted batch that can still be restored.
#: admin/class-admin.php:583
#, php-format
msgid "%d recently deleted cookie(s) can still be restored."
msgstr "%d nedavno izbrisanih kolačića i dalje se može vratiti."

#. translators: 1: number of cookies in the most recent deleted batch, 2: human-readable age of that batch, such as "3 hours" or "8 months".
#: admin/class-admin.php:585
#, php-format
msgid "%1$d deleted cookie(s) can still be restored (deleted %2$s ago)."
msgstr "%1$d izbrisanih kolačića i dalje se može vratiti (izbrisano prije %2$s)."

#. translators: %d: number of cookies put back by the restore.
#: admin/class-admin.php:587
#, php-format
msgid "%d cookie(s) restored."
msgstr "%d kolačića vraćeno."

#: admin/class-admin.php:588
msgid "Could not restore the deleted cookies."
msgstr "Nije moguće vratiti izbrisane kolačiće."

#: admin/class-admin.php:589
msgid "There is nothing left to restore."
msgstr "Nema više ničega za vraćanje."

#: admin/class-admin.php:590
msgid "Nothing was deleted: the undo snapshot could not be saved, so the cookies were left in place."
msgstr "Ništa nije izbrisano: snimku za poništavanje nije bilo moguće spremiti, pa su kolačići ostavljeni netaknuti."

#. translators: %d: number of cookies that were present in the browser before the scan started and were not imported.
#: admin/class-admin.php:595
#, php-format
msgid "%d cookie(s) were already in your browser when the scan started, so they could not be attributed to any page and were not imported."
msgstr "%d kolačića već je bilo u vašem pregledniku kada je skeniranje započelo, pa ih nije bilo moguće pripisati nijednoj stranici te nisu uvezeni."

#: admin/class-admin.php:596
msgid "Show the names"
msgstr "Prikaži nazive"

#: admin/class-admin.php:597
msgid "If you recognise one as a cookie your site really sets, declare it in the list below — the scan already recorded its domain and lifetime."
msgstr "Ako neki od njih prepoznate kao kolačić koji vaša stranica doista postavlja, prijavite ga na popisu u nastavku — skeniranje je već zabilježilo njegovu domenu i trajanje."

#. translators: %s: id of the scan the visitor check belongs to (a 32-char hex token, not a number).
#: admin/class-admin.php:601
#, php-format
msgid "Server-side visitor check (headers only) — scan #%s:"
msgstr "Provjera posjetitelja na strani poslužitelja (samo zaglavlja) — skeniranje #%s:"

#. translators: 1: number of cookies, 2: comma-separated cookie names.
#: admin/class-admin.php:603
#, php-format
msgid "%1$d cookie(s) were set for the anonymous check but never seen by the logged-in browser scan, and were added to the declaration: %2$s"
msgstr "%1$d kolačića postavljeno je za anonimnu provjeru, ali ih skeniranje putem prijavljenog preglednika nije nikada uočilo, pa su dodani u deklaraciju: %2$s"

#. translators: 1: number of cookies, 2: comma-separated cookie names.
#: admin/class-admin.php:605
#, php-format
msgid "%1$d cookie(s) the scan could not attribute were confirmed by the anonymous check — the site sets them for visitors, so they are declared: %2$s"
msgstr "%1$d kolačića koje skeniranje nije moglo pripisati potvrđeno je anonimnom provjerom — stranica ih postavlja posjetiteljima, pa su deklarirani: %2$s"

#. translators: 1: number of cookies, 2: comma-separated cookie names.
#: admin/class-admin.php:607
#, php-format
msgid "%1$d cookie(s) were seen only in your browser and not confirmed for visitors; they stay reported, not declared: %2$s"
msgstr "%1$d kolačića uočeno je samo u vašem pregledniku i nije potvrđeno za posjetitelje; ostaju prijavljeni, ali nisu deklarirani: %2$s"

#: admin/class-admin.php:608
msgid "The anonymous check found no cookie differences against the browser scan."
msgstr "Anonimna provjera nije pronašla razlike u kolačićima u odnosu na skeniranje preglednikom."

#: admin/class-admin.php:609
msgid "This check re-fetches the scanned pages without a login and compares Set-Cookie headers only. It cannot see cookies that JavaScript sets for anonymous visitors, nor cookies set only after an interaction (for example an add-to-cart request), so a clean result does not mean the visitor view is fully verified."
msgstr "Ova provjera ponovno dohvaća skenirane stranice bez prijave i uspoređuje isključivo Set-Cookie zaglavlja. Ne može vidjeti kolačiće koje JavaScript postavlja anonimnim posjetiteljima, niti kolačiće koji se postavljaju tek nakon interakcije (na primjer zahtjeva za dodavanje u košaricu), pa čist rezultat ne znači da je prikaz za posjetitelje u potpunosti provjeren."

#. translators: %d: number of cookies the scan could not attribute to a page.
#: admin/class-admin.php:615
#, php-format
msgid "%d cookie(s) were seen in your browser during the last scan but could not be attributed to a scanned page:"
msgstr "Tijekom posljednjeg skeniranja u vašem je pregledniku zabilježeno %d kolačića koje nije bilo moguće pripisati nijednoj skeniranoj stranici:"

#: admin/class-admin.php:616
msgid "A scan runs from your logged-in session, so it cannot tell whether visitors receive these too — that depends on how your site is configured. Declare the ones you know reach visitors; leave the rest."
msgstr "Skeniranje se izvodi iz vaše prijavljene sesije pa ne može utvrditi primaju li i posjetitelji te kolačiće — to ovisi o konfiguraciji vaše stranice. Prijavite one za koje znate da dopiru do posjetitelja, a ostale ostavite."

#: admin/class-admin.php:617
msgid "Declare this cookie"
msgstr "Prijavi ovaj kolačić"

#: admin/class-admin.php:618
msgid "This name is normally hidden from the banner and the cookie policy. Declaring it will also make it visible there. It is never deleted either way."
msgstr "Taj je naziv uobičajeno skriven u banneru i u pravilima o kolačićima. Prijavom će postati vidljiv i ondje. Ni u kojem slučaju neće biti izbrisan."

#. translators: %s: cookie name.
#: admin/class-admin.php:620
#, php-format
msgid "%s is now declared."
msgstr "%s je sada prijavljen."

#: admin/class-admin.php:621
msgid "Could not declare that cookie."
msgstr "Nije bilo moguće prijaviti taj kolačić."

#: admin/class-admin.php:623
msgid "Stop scan"
msgstr "Zaustavi skeniranje"

#: admin/class-admin.php:624
msgid "Stopping…"
msgstr "Zaustavljanje…"

#: admin/class-admin.php:625
msgid "(stopped by you before every page was visited)"
msgstr "(zaustavili ste prije nego što su posjećene sve stranice)"

#: admin/class-admin.php:626
msgid "Failed to delete stale cookies."
msgstr "Brisanje zastarjelih kolačića nije uspjelo."

#: admin/class-admin.php:627
msgid "Failed to load cookies for stale cleanup."
msgstr "Učitavanje kolačića za čišćenje zastarjelih podataka nije uspjelo."

#: admin/class-admin.php:628
msgid "Scanning..."
msgstr "Skeniranje..."

#: admin/class-admin.php:629 admin/views/cookies.php:98
msgid "Scan Site"
msgstr "Skeniraj stranicu"

#: admin/class-admin.php:630
msgid "Scan failed."
msgstr "Skeniranje nije uspjelo."

#. translators: %1$d: number of cookies found by the scan, %2$d: number of pages scanned
#: admin/class-admin.php:632
#, php-format
msgid "Scan complete — %1$d cookies found on %2$d pages"
msgstr "Skeniranje dovršeno — pronađeno %1$d kolačića na %2$d stranica"

#. translators: %s: machine-readable reason the scan stopped before visiting every page, e.g. "no-new-findings"
#: admin/class-admin.php:634
#, php-format
msgid "(early stop: %s)"
msgstr "(prijevremeni prekid: %s)"

#. translators: %d: number of catalogued cookies the latest scan did not observe
#: admin/class-admin.php:636
#, php-format
msgid "%d stale cookie(s) highlighted"
msgstr "Istaknuto %d zastarjelih kolačića"

#. translators: appended to the scan summary when the scan was capped, incremental, early-stopped or degraded, and therefore could not prove that a catalogued cookie is gone.
#: admin/class-admin.php:638
msgid "Scan coverage was incomplete, so no cookie was marked as stale."
msgstr "Pokrivenost skeniranja bila je nepotpuna, pa nijedan kolačić nije označen kao zastarjeli."

#: admin/class-admin.php:641
msgid "The browser scan was saved. Server-header enrichment is still running in the background, so a few more cookies may appear shortly."
msgstr "Skeniranje putem preglednika je spremljeno. Obogaćivanje putem zaglavlja poslužitelja i dalje se izvodi u pozadini, pa se uskoro mogu pojaviti dodatni kolačići."

#: admin/class-admin.php:642
msgid "No pages found to scan."
msgstr "Nisu pronađene stranice za skeniranje."

#: admin/class-admin.php:643
msgid "Failed to discover pages."
msgstr "Otkrivanje stranica nije uspjelo."

#: admin/class-admin.php:644
msgid "Scan finished but failed to save results."
msgstr "Skeniranje je završeno, ali spremanje rezultata nije uspjelo."

#. translators: %1$d: number of cookies an earlier attempt already imported, %2$d: number of pages scanned
#: admin/class-admin.php:649
#, php-format
msgid "Already saved — %1$d cookies on %2$d pages were imported by an earlier attempt. Nothing was saved twice."
msgstr "Već spremljeno — %1$d kolačića na %2$d stranica uvezeno je prethodnim pokušajem. Ništa nije spremljeno dvaput."

#: admin/class-admin.php:650
msgid "Not saved"
msgstr "Nije spremljeno"

#: admin/class-admin.php:651
msgid "The scan finished but the results could not be saved. Nothing is lost — they are held on the server for a few minutes. Retrying saves them; it does not scan the site again."
msgstr "Skeniranje je završeno, ali rezultate nije bilo moguće spremiti. Ništa nije izgubljeno — zadržani su na poslužitelju nekoliko minuta. Ponovni pokušaj ih sprema; ne skenira stranicu ponovno."

#: admin/class-admin.php:652
msgid "The scan finished but the results could not be saved. The capture session is held on the server for a few minutes, so retrying reuses it instead of failing — but this browser has to walk the pages again."
msgstr "Skeniranje je završeno, ali rezultate nije bilo moguće spremiti. Sesija snimanja zadržana je na poslužitelju nekoliko minuta, pa je ponovni pokušaj ponovno koristi umjesto da ne uspije — no ovaj preglednik mora ponovno proći kroz stranice."

#: admin/class-admin.php:653
msgid "Retry import"
msgstr "Ponovi uvoz"

#: admin/class-admin.php:654
msgid "Retry import (re-scans the site)"
msgstr "Ponovi uvoz (ponovno skenira stranicu)"

#: admin/class-admin.php:655
msgid "Discard"
msgstr "Odbaci"

#. translators: %s: clock time the scan session was opened, e.g. "14:32"
#: admin/class-admin.php:659
#, php-format
msgid "A cookie scan session for your account is already open on the server (started at %s). A new scan cannot start until it ends."
msgstr "Sesija skeniranja kolačića za vaš račun već je otvorena na poslužitelju (započela u %s). Novo skeniranje ne može započeti dok se ona ne završi."

#. translators: %1$d: number of cookie observations captured so far, %2$s: clock time of the most recent one
#: admin/class-admin.php:661
#, php-format
msgid "It is capturing right now — %1$d observation(s) so far, the last at %2$s. If one of your other tabs is running a scan, let it finish. Ending the session discards everything it has captured."
msgstr "Trenutno snima — dosad %1$d opažanja, posljednje u %2$s. Ako neka od vaših drugih kartica izvodi skeniranje, pričekajte da završi. Prekid sesije odbacuje sve što je snimljeno."

#. translators: %s: clock time the scan session last showed any activity
#: admin/class-admin.php:663
#, php-format
msgid "Nothing has reached the server since %s. If none of your tabs is running a scan, the tab that was driving this one is gone. The session will expire on its own in a few minutes, or you can end it now — ending it discards everything it captured."
msgstr "Ništa nije stiglo do poslužitelja od %s. Ako nijedna od vaših kartica ne izvodi skeniranje, kartica koja je pokretala ovu sesiju više ne postoji. Sesija će sama isteći za nekoliko minuta, ili je možete odmah prekinuti — prekid odbacuje sve što je snimljeno."

#: admin/class-admin.php:664
msgid "End this scan and discard its capture"
msgstr "Prekini ovo skeniranje i odbaci snimljene podatke"

#: admin/class-admin.php:665
msgid "Scan session ended — its capture was discarded. You can start a new scan."
msgstr "Sesija skeniranja je prekinuta — snimljeni podaci su odbačeni. Možete započeti novo skeniranje."

#: admin/class-admin.php:666
msgid "The browser scan could not inspect any page. Make sure the public site is reachable through the WordPress admin origin and that framing is not blocked."
msgstr "Skeniranje putem preglednika nije moglo pregledati nijednu stranicu. Provjerite je li javna stranica dostupna putem izvora WordPress administracije i da uokvirivanje (framing) nije blokirano."

#: admin/class-admin.php:667
msgid "Discovering pages..."
