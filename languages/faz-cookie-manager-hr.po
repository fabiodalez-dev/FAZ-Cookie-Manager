#: admin/modules/settings/api/class-api.php:763
msgid "Unavailable because jurisdiction enforcement is off. The active banner law applies to every visitor instead."
msgstr "Nedostupno jer je provedba nadležnosti isključena. Umjesto toga, zakon spremljen u aktivnom banneru primjenjuje se na svakog posjetitelja."

#: admin/modules/settings/api/class-api.php:764
msgid "Safe fallback: country-based language selection still changes server output, so these pages bypass the full-page cache."
msgstr "Sigurni pričuvni način: odabir jezika prema zemlji i dalje mijenja izlaz poslužitelja, pa ove stranice zaobilaze predmemoriju cijele stranice."

#: admin/modules/settings/api/class-api.php:765
msgid "Safe fallback: IAB TCF output is not yet represented by the bootstrap payload, so these pages bypass the full-page cache."
msgstr "Sigurni pričuvni način: IAB TCF izlaz još nije zastupljen u bootstrap podacima, pa ove stranice zaobilaze predmemoriju cijele stranice."

#: admin/modules/settings/api/class-api.php:766
msgid "Safe fallback: hiding the banner outside target regions changes server output, so these pages bypass the full-page cache."
msgstr "Sigurni pričuvni način: skrivanje bannera izvan ciljanih regija mijenja izlaz poslužitelja, pa ove stranice zaobilaze predmemoriju cijele stranice."

#: admin/modules/settings/api/class-api.php:767
msgid "Safe fallback: one or more banners target specific countries, so these pages bypass the full-page cache."
msgstr "Sigurni pričuvni način: jedan ili više bannera ciljaju određene zemlje, pa ove stranice zaobilaze predmemoriju cijele stranice."

#: admin/modules/settings/api/class-api.php:768
msgid "Safe fallback: a custom integration declared country-dependent output, so these pages bypass the full-page cache."
msgstr "Sigurni pričuvni način: prilagođena integracija prijavila je izlaz ovisan o zemlji, pa ove stranice zaobilaze predmemoriju cijele stranice."

#: admin/modules/settings/api/class-api.php:769
msgid "Safe fallback: no active global GDPR banner is available for the strict shell, so these pages bypass the full-page cache."
msgstr "Sigurni pričuvni način: za strogu ljusku nije dostupan aktivni globalni GDPR banner, pa ove stranice zaobilaze predmemoriju cijele stranice."

#: admin/modules/settings/api/class-api.php:770
