#: admin/views/system-status.php:214
#: includes/class-cookie-table-shortcode.php:283
msgid "Category"
msgstr "Kategorie"

#: admin/class-admin.php:615
msgid "Cancel"
msgstr "Abbrechen"

#: admin/class-admin.php:616
msgid "Cookie updated."
msgstr "Cookie aktualisiert."

#: admin/class-admin.php:617
msgid "Cookie added."
msgstr "Cookie hinzugefügt."

#: admin/class-admin.php:618
msgid "Failed to save cookie."
msgstr "Cookie konnte nicht gespeichert werden."

#. translators: %s: cookie name
#: admin/class-admin.php:620
#, php-format
msgid "Delete cookie \"%s\"?"
msgstr "Cookie \"%s\" löschen?"

#: admin/class-admin.php:621
msgid "Cookie deleted."
msgstr "Cookie gelöscht."

#: admin/class-admin.php:622
msgid "Failed to delete cookie."
msgstr "Cookie konnte nicht gelöscht werden."

#: admin/class-admin.php:623
msgid "Stale cookie deleted."
msgstr "Veraltetes Cookie gelöscht."

#: admin/class-admin.php:624
msgid "Failed to delete stale cookie."
msgstr "Veraltetes Cookie konnte nicht gelöscht werden."

#: admin/class-admin.php:626
msgid "Select a service…"
msgstr "Dienst auswählen …"

#: admin/class-admin.php:627
msgid "Could not load services"
msgstr "Dienste konnten nicht geladen werden"

#. translators: 1: service label, 2: number of cookies registered.
#: admin/class-admin.php:629
#, php-format
msgid "%1$s: %2$d cookie(s) registered"
msgstr "%1$s: %2$d Cookie(s) registriert"

#: admin/class-admin.php:630
msgid "Could not register service."
msgstr "Dienst konnte nicht registriert werden."

#: admin/class-admin.php:631
msgid "Remove these cookie-policy entries? Cookies that load only after an interaction, during a flow, or as httpOnly cookies may still be present even if the scan did not observe them."
msgstr "Diese Cookie-Richtlinien-Einträge entfernen? Cookies, die erst nach einer Interaktion, während eines Ablaufs oder als httpOnly-Cookies geladen werden, können weiterhin vorhanden sein, auch wenn der Scan sie nicht erfasst hat."

#: admin/class-admin.php:632
msgid "No stale cookies to delete."
msgstr "Keine veralteten Cookies zu löschen."

#. translators: %d: number of entries the server kept because they have not yet been missing from enough consecutive complete scans.
#: admin/class-admin.php:634
#, php-format
msgid "%d entry(ies) were kept: they have not yet been missing from enough complete scans."
msgstr "%d Eintrag/Einträge wurden beibehalten: Sie fehlten noch nicht in ausreichend vielen vollständigen Scans."

#: admin/class-admin.php:636
msgid "Undo delete"
msgstr "Löschen rückgängig machen"

#. translators: %d: number of cookies in the most recent deleted batch that can still be restored.
#: admin/class-admin.php:638
#, php-format
msgid "%d recently deleted cookie(s) can still be restored."
msgstr "%d kürzlich gelöschte(s) Cookie(s) können noch wiederhergestellt werden."

#. translators: 1: number of cookies in the most recent deleted batch, 2: human-readable age of that batch, such as "3 hours" or "8 months".
#: admin/class-admin.php:640
#, php-format
msgid "%1$d deleted cookie(s) can still be restored (deleted %2$s ago)."
msgstr "%1$d gelöschte(s) Cookie(s) können noch wiederhergestellt werden (gelöscht vor %2$s)."

#. translators: %d: number of cookies put back by the restore.
#: admin/class-admin.php:642
#, php-format
msgid "%d cookie(s) restored."
msgstr "%d Cookie(s) wiederhergestellt."

#: admin/class-admin.php:643
msgid "Could not restore the deleted cookies."
msgstr "Die gelöschten Cookies konnten nicht wiederhergestellt werden."

#: admin/class-admin.php:644
msgid "There is nothing left to restore."
msgstr "Es gibt nichts mehr wiederherzustellen."

#: admin/class-admin.php:645
msgid "Nothing was deleted: the undo snapshot could not be saved, so the cookies were left in place."
msgstr "Es wurde nichts gelöscht: Der Wiederherstellungs-Snapshot konnte nicht gespeichert werden, daher wurden die Cookies unverändert belassen."

#. translators: %d: number of cookies that were present in the browser before the scan started and were not imported.
#: admin/class-admin.php:650
#, php-format
msgid "%d cookie(s) were already in your browser when the scan started, so they could not be attributed to any page and were not imported."
msgstr "%d Cookie(s) befanden sich bereits in Ihrem Browser, als der Scan startete, konnten daher keiner Seite zugeordnet und nicht importiert werden."

#: admin/class-admin.php:651
msgid "Show the names"
msgstr "Namen anzeigen"

#: admin/class-admin.php:652
msgid "If you recognise one as a cookie your site really sets, declare it in the list below — the scan already recorded its domain and lifetime."
msgstr "Wenn Sie eines davon als ein Cookie erkennen, das Ihre Website tatsächlich setzt, deklarieren Sie es in der Liste unten — die Prüfung hat Domain und Lebensdauer bereits erfasst."

#. translators: %s: id of the scan the visitor check belongs to (a 32-char hex token, not a number).
#: admin/class-admin.php:656
#, php-format
msgid "Server-side visitor check (headers only) — scan #%s:"
msgstr "Serverseitige Besucherprüfung (nur Header) — Scan Nr. %s:"

#. translators: 1: number of cookies, 2: comma-separated cookie names.
#: admin/class-admin.php:658
#, php-format
msgid "%1$d cookie(s) were set for the anonymous check but never seen by the logged-in browser scan, and were added to the declaration: %2$s"
msgstr "%1$d Cookie(s) wurden bei der anonymen Prüfung gesetzt, aber vom Browser-Scan des angemeldeten Nutzers nie beobachtet, und wurden der Deklaration hinzugefügt: %2$s"

#. translators: 1: number of cookies, 2: comma-separated cookie names.
#: admin/class-admin.php:660
#, php-format
msgid "%1$d cookie(s) the scan could not attribute were confirmed by the anonymous check — the site sets them for visitors, so they are declared: %2$s"
msgstr "%1$d Cookie(s), die der Scan nicht zuordnen konnte, wurden durch die anonyme Prüfung bestätigt — die Website setzt sie für Besucher, daher werden sie deklariert: %2$s"

#. translators: 1: number of cookies, 2: comma-separated cookie names.
#: admin/class-admin.php:662
#, php-format
msgid "%1$d cookie(s) were seen only in your browser and not confirmed for visitors; they stay reported, not declared: %2$s"
msgstr "%1$d Cookie(s) wurden nur in Ihrem Browser beobachtet und für Besucher nicht bestätigt; sie bleiben gemeldet, aber nicht deklariert: %2$s"

#: admin/class-admin.php:663
msgid "The anonymous check found no cookie differences against the browser scan."
msgstr "Die anonyme Prüfung hat keine Cookie-Unterschiede zum Browser-Scan festgestellt."

#: admin/class-admin.php:664
msgid "This check re-fetches the scanned pages without a login and compares Set-Cookie headers only. It cannot see cookies that JavaScript sets for anonymous visitors, nor cookies set only after an interaction (for example an add-to-cart request), so a clean result does not mean the visitor view is fully verified."
msgstr "Diese Prüfung ruft die gescannten Seiten ohne Anmeldung erneut ab und vergleicht ausschließlich die Set-Cookie-Header. Sie kann keine Cookies erkennen, die JavaScript für anonyme Besucher setzt, ebenso wenig Cookies, die erst nach einer Interaktion gesetzt werden (zum Beispiel bei einer In-den-Warenkorb-Anfrage). Ein sauberes Ergebnis bedeutet daher nicht, dass die Besucheransicht vollständig verifiziert ist."

#. translators: %d: number of cookies the scan could not attribute to a page.
#: admin/class-admin.php:670
#, php-format
msgid "%d cookie(s) were seen in your browser during the last scan but could not be attributed to a scanned page:"
msgstr "%d Cookie(s) wurden bei der letzten Prüfung in Ihrem Browser gesehen, konnten aber keiner geprüften Seite zugeordnet werden:"

#: admin/class-admin.php:671
msgid "A scan runs from your logged-in session, so it cannot tell whether visitors receive these too — that depends on how your site is configured. Declare the ones you know reach visitors; leave the rest."
msgstr "Eine Prüfung läuft in Ihrer angemeldeten Sitzung und kann daher nicht feststellen, ob Besucher diese Cookies ebenfalls erhalten — das hängt von der Konfiguration Ihrer Website ab. Deklarieren Sie die Cookies, von denen Sie wissen, dass sie Besucher erreichen; lassen Sie die übrigen unangetastet."

#: admin/class-admin.php:672
msgid "Declare this cookie"
msgstr "Dieses Cookie deklarieren"

#: admin/class-admin.php:673
msgid "This name is normally hidden from the banner and the cookie policy. Declaring it will also make it visible there. It is never deleted either way."
msgstr "Dieser Name wird normalerweise im Banner und in der Cookie-Richtlinie ausgeblendet. Durch die Deklaration wird er auch dort sichtbar. Gelöscht wird er in keinem Fall."

#. translators: %s: cookie name.
#: admin/class-admin.php:675
#, php-format
msgid "%s is now declared."
msgstr "%s ist jetzt deklariert."

#: admin/class-admin.php:676
msgid "Could not declare that cookie."
msgstr "Dieses Cookie konnte nicht deklariert werden."

#: admin/class-admin.php:678
msgid "Stop scan"
msgstr "Scan stoppen"

#: admin/class-admin.php:679
msgid "Stopping…"
msgstr "Wird gestoppt …"

#: admin/class-admin.php:680
msgid "(stopped by you before every page was visited)"
msgstr "(von Ihnen gestoppt, bevor jede Seite besucht wurde)"

#: admin/class-admin.php:681
msgid "Failed to delete stale cookies."
msgstr "Veraltete Cookies konnten nicht gelöscht werden."

#: admin/class-admin.php:682
msgid "Failed to load cookies for stale cleanup."
msgstr "Cookies für die Bereinigung veralteter Daten konnten nicht geladen werden."

#: admin/class-admin.php:683
msgid "Scanning..."
msgstr "Wird gescannt..."

#: admin/class-admin.php:684 admin/views/cookies.php:98
msgid "Scan Site"
msgstr "Website scannen"

#: admin/class-admin.php:685
msgid "Scan failed."
msgstr "Scan fehlgeschlagen."

#. translators: %1$d: number of cookies found by the scan, %2$d: number of pages scanned
#: admin/class-admin.php:687
#, php-format
msgid "Scan complete — %1$d cookies found on %2$d pages"
msgstr "Scan abgeschlossen — %1$d Cookies auf %2$d Seiten gefunden"

#. translators: %s: machine-readable reason the scan stopped before visiting every page, e.g. "no-new-findings"
#: admin/class-admin.php:689
#, php-format
msgid "(early stop: %s)"
msgstr "(vorzeitig beendet: %s)"

#. translators: %d: number of catalogued cookies the latest scan did not observe
#: admin/class-admin.php:691
#, php-format
msgid "%d stale cookie(s) highlighted"
msgstr "%d veraltete(s) Cookie(s) hervorgehoben"

#. translators: appended to the scan summary when the scan was capped, incremental, early-stopped or degraded, and therefore could not prove that a catalogued cookie is gone.
#: admin/class-admin.php:693
msgid "Scan coverage was incomplete, so no cookie was marked as stale."
msgstr "Die Scan-Abdeckung war unvollständig, daher wurde kein Cookie als veraltet markiert."

#: admin/class-admin.php:696
msgid "The browser scan was saved. Server-header enrichment is still running in the background, so a few more cookies may appear shortly."
msgstr "Der Browser-Scan wurde gespeichert. Die Anreicherung mit Server-Headern läuft noch im Hintergrund, sodass in Kürze noch weitere Cookies erscheinen können."

#: admin/class-admin.php:697
msgid "No pages found to scan."
msgstr "Keine zu scannenden Seiten gefunden."

#: admin/class-admin.php:698
msgid "Failed to discover pages."
msgstr "Seiten konnten nicht ermittelt werden."

#: admin/class-admin.php:699
msgid "Scan finished but failed to save results."
msgstr "Scan abgeschlossen, aber die Ergebnisse konnten nicht gespeichert werden."

#. translators: %1$d: number of cookies an earlier attempt already imported, %2$d: number of pages scanned
#: admin/class-admin.php:704
#, php-format
msgid "Already saved — %1$d cookies on %2$d pages were imported by an earlier attempt. Nothing was saved twice."
msgstr "Bereits gespeichert — %1$d Cookies auf %2$d Seiten wurden durch einen früheren Versuch importiert. Es wurde nichts doppelt gespeichert."

#: admin/class-admin.php:705
msgid "Not saved"
msgstr "Nicht gespeichert"

#: admin/class-admin.php:706
msgid "The scan finished but the results could not be saved. Nothing is lost — they are held on the server for a few minutes. Retrying saves them; it does not scan the site again."
msgstr "Der Scan wurde abgeschlossen, aber die Ergebnisse konnten nicht gespeichert werden. Es geht nichts verloren — sie werden einige Minuten lang auf dem Server aufbewahrt. Ein erneuter Versuch speichert sie; die Website wird dabei nicht erneut gescannt."

#: admin/class-admin.php:707
msgid "The scan finished but the results could not be saved. The capture session is held on the server for a few minutes, so retrying reuses it instead of failing — but this browser has to walk the pages again."
msgstr "Der Scan wurde abgeschlossen, aber die Ergebnisse konnten nicht gespeichert werden. Die Erfassungssitzung wird einige Minuten lang auf dem Server aufbewahrt, sodass ein erneuter Versuch sie wiederverwendet, anstatt fehlzuschlagen — dieser Browser muss die Seiten jedoch erneut durchlaufen."

#: admin/class-admin.php:708
msgid "Retry import"
msgstr "Import erneut versuchen"

#: admin/class-admin.php:709
msgid "Retry import (re-scans the site)"
msgstr "Import erneut versuchen (scannt die Website erneut)"

#: admin/class-admin.php:710
msgid "Discard"
msgstr "Verwerfen"

#. translators: %s: clock time the scan session was opened, e.g. "14:32"
#: admin/class-admin.php:714
#, php-format
msgid "A cookie scan session for your account is already open on the server (started at %s). A new scan cannot start until it ends."
msgstr "Für Ihr Konto ist auf dem Server bereits eine Cookie-Scan-Sitzung geöffnet (gestartet um %s). Ein neuer Scan kann erst starten, wenn diese beendet ist."

#. translators: %1$d: number of cookie observations captured so far, %2$s: clock time of the most recent one
#: admin/class-admin.php:716
#, php-format
msgid "It is capturing right now — %1$d observation(s) so far, the last at %2$s. If one of your other tabs is running a scan, let it finish. Ending the session discards everything it has captured."
msgstr "Sie erfasst gerade Daten — bisher %1$d Beobachtung(en), die letzte um %2$s. Wenn einer Ihrer anderen Tabs einen Scan ausführt, lassen Sie ihn abschließen. Das Beenden der Sitzung verwirft alles bisher Erfasste."

#. translators: %s: clock time the scan session last showed any activity
#: admin/class-admin.php:718
#, php-format
msgid "Nothing has reached the server since %s. If none of your tabs is running a scan, the tab that was driving this one is gone. The session will expire on its own in a few minutes, or you can end it now — ending it discards everything it captured."
msgstr "Seit %s ist nichts mehr beim Server eingegangen. Wenn keiner Ihrer Tabs einen Scan ausführt, ist der Tab, der diesen gesteuert hat, nicht mehr vorhanden. Die Sitzung läuft in wenigen Minuten von selbst ab, oder Sie können sie jetzt beenden — das Beenden verwirft alles Erfasste."

#: admin/class-admin.php:719
msgid "End this scan and discard its capture"
msgstr "Diesen Scan beenden und seine Erfassung verwerfen"

#: admin/class-admin.php:720
msgid "Scan session ended — its capture was discarded. You can start a new scan."
msgstr "Scan-Sitzung beendet — ihre Erfassung wurde verworfen. Sie können einen neuen Scan starten."

#: admin/class-admin.php:721
msgid "The browser scan could not inspect any page. Make sure the public site is reachable through the WordPress admin origin and that framing is not blocked."
msgstr "Der Browser-Scan konnte keine Seite untersuchen. Stellen Sie sicher, dass die öffentliche Website über den WordPress-Admin-Ursprung erreichbar ist und dass das Framing nicht blockiert wird."

#: admin/class-admin.php:722
msgid "Discovering pages..."
msgstr "Seiten werden ermittelt..."

#: admin/class-admin.php:723
msgid "Enriching with server scan..."
msgstr "Anreicherung mit Server-Scan läuft..."

#: admin/class-admin.php:724
msgid "Saving results..."
msgstr "Ergebnisse werden gespeichert..."

#: admin/class-admin.php:725
msgid "No cookies to process."
msgstr "Keine Cookies zu verarbeiten."

#: admin/class-admin.php:726
msgid "No uncategorized cookies to process."
msgstr "Keine nicht kategorisierten Cookies zu verarbeiten."

#: admin/class-admin.php:727
msgid "No cookies could be auto-categorized."
msgstr "Kein Cookie konnte automatisch kategorisiert werden."

#: admin/class-admin.php:728
msgid "Auto-categorize failed."
msgstr "Automatisches Kategorisieren fehlgeschlagen."

#: admin/class-admin.php:729
msgid "No definitions downloaded yet. Click \"Update Definitions\" to download."
msgstr "Noch keine Definitionen heruntergeladen. Klicken Sie auf \"Definitionen aktualisieren\", um sie herunterzuladen."

#: admin/class-admin.php:730
msgid "Could not load definitions status."
msgstr "Status der Definitionen konnte nicht geladen werden."

#: admin/class-admin.php:731
msgid "Downloading definitions from GitHub..."
msgstr "Definitionen werden von GitHub heruntergeladen..."

#: admin/class-admin.php:732
msgid "Definitions updated."
msgstr "Definitionen aktualisiert."

#: admin/class-admin.php:733
msgid "Update failed."
msgstr "Aktualisierung fehlgeschlagen."

