#: admin/class-admin.php:571
msgid "Select a service…"
msgstr "Seleziona un servizio…"

#: admin/class-admin.php:572
msgid "Could not load services"
msgstr "Impossibile caricare i servizi"

#. translators: 1: service label, 2: number of cookies registered.
#: admin/class-admin.php:574
#, php-format
msgid "%1$s: %2$d cookie(s) registered"
msgstr "%1$s: %2$d cookie registrati"

#: admin/class-admin.php:575
msgid "Could not register service."
msgstr "Impossibile registrare il servizio."

#: admin/class-admin.php:576
msgid "Remove these cookie-policy entries? Cookies that load only after an interaction, during a flow, or as httpOnly cookies may still be present even if the scan did not observe them."
msgstr "Rimuovere queste voci dalla cookie policy? I cookie che si caricano solo dopo un'interazione, durante un percorso, o come cookie httpOnly possono essere comunque presenti anche se la scansione non li ha osservati."

#: admin/class-admin.php:577
msgid "No stale cookies to delete."
msgstr "Nessun cookie obsoleto da eliminare."

#. translators: %d: number of entries the server kept because they have not yet been missing from enough consecutive complete scans.
#: admin/class-admin.php:579
#, php-format
msgid "%d entry(ies) were kept: they have not yet been missing from enough complete scans."
msgstr "%d voci mantenute: non sono ancora mancate da un numero sufficiente di scansioni complete."

#: admin/class-admin.php:581
msgid "Undo delete"
msgstr "Annulla eliminazione"

#. translators: %d: number of cookies in the most recent deleted batch that can still be restored.
#: admin/class-admin.php:583
#, php-format
msgid "%d recently deleted cookie(s) can still be restored."
msgstr "%d cookie eliminati di recente possono ancora essere ripristinati."

#. translators: 1: number of cookies in the most recent deleted batch, 2: human-readable age of that batch, such as "3 hours" or "8 months".
#: admin/class-admin.php:585
#, php-format
msgid "%1$d deleted cookie(s) can still be restored (deleted %2$s ago)."
msgstr "%1$d cookie eliminati possono ancora essere ripristinati (eliminati %2$s fa)."

#. translators: %d: number of cookies put back by the restore.
#: admin/class-admin.php:587
#, php-format
msgid "%d cookie(s) restored."
msgstr "%d cookie ripristinati."

#: admin/class-admin.php:588
msgid "Could not restore the deleted cookies."
msgstr "Impossibile ripristinare i cookie eliminati."

#: admin/class-admin.php:589
msgid "There is nothing left to restore."
msgstr "Non c'è più nulla da ripristinare."

#: admin/class-admin.php:590
msgid "Nothing was deleted: the undo snapshot could not be saved, so the cookies were left in place."
msgstr "Non è stato eliminato nulla: non è stato possibile salvare lo snapshot di annullamento, quindi i cookie sono stati lasciati al loro posto."

#. translators: %d: number of cookies that were present in the browser before the scan started and were not imported.
#: admin/class-admin.php:595
#, php-format
msgid "%d cookie(s) were already in your browser when the scan started, so they could not be attributed to any page and were not imported."
msgstr "%d cookie erano già presenti nel tuo browser all'avvio della scansione, quindi non è stato possibile attribuirli a nessuna pagina e non sono stati importati."

#: admin/class-admin.php:596
msgid "Show the names"
msgstr "Mostra i nomi"

#: admin/class-admin.php:597
msgid "If you recognise one as a cookie your site really sets, add it manually with Add Cookie."
msgstr "Se ne riconosci uno come un cookie che il tuo sito imposta davvero, aggiungilo a mano con Aggiungi cookie."

#. translators: %s: id of the scan the visitor check belongs to (a 32-char hex token, not a number).
#: admin/class-admin.php:601
#, php-format
msgid "Server-side visitor check (headers only) — scan #%s:"
msgstr "Verifica lato server come visitatore (solo intestazioni) — scansione n. %s:"

#. translators: 1: number of cookies, 2: comma-separated cookie names.
#: admin/class-admin.php:603
#, php-format
msgid "%1$d cookie(s) were set for the anonymous check but never seen by the logged-in browser scan, and were added to the declaration: %2$s"
msgstr "%1$d cookie sono stati impostati durante la verifica anonima ma mai visti dalla scansione del browser autenticato, e sono stati aggiunti alla dichiarazione: %2$s"

#. translators: 1: number of cookies, 2: comma-separated cookie names.
#: admin/class-admin.php:605
#, php-format
msgid "%1$d cookie(s) the scan could not attribute were confirmed by the anonymous check — the site sets them for visitors, so they are declared: %2$s"
msgstr "%1$d cookie che la scansione non era riuscita ad attribuire sono stati confermati dalla verifica anonima — il sito li imposta per i visitatori, quindi vengono dichiarati: %2$s"

#. translators: 1: number of cookies, 2: comma-separated cookie names.
#: admin/class-admin.php:607
#, php-format
msgid "%1$d cookie(s) were seen only in your browser and not confirmed for visitors; they stay reported, not declared: %2$s"
msgstr "%1$d cookie sono stati visti solo nel tuo browser e non confermati per i visitatori; restano segnalati, non dichiarati: %2$s"

#: admin/class-admin.php:608
msgid "The anonymous check found no cookie differences against the browser scan."
msgstr "La verifica anonima non ha rilevato differenze nei cookie rispetto alla scansione del browser."

#: admin/class-admin.php:609
msgid "This check re-fetches the scanned pages without a login and compares Set-Cookie headers only. It cannot see cookies that JavaScript sets for anonymous visitors, nor cookies set only after an interaction (for example an add-to-cart request), so a clean result does not mean the visitor view is fully verified."
msgstr "Questa verifica riscarica le pagine analizzate senza autenticazione e confronta solo le intestazioni Set-Cookie. Non può vedere i cookie che JavaScript imposta per i visitatori anonimi, né quelli impostati solo dopo un'interazione (per esempio un'aggiunta al carrello): un esito pulito non significa quindi che la vista del visitatore sia verificata del tutto."

#: admin/class-admin.php:611
msgid "Stop scan"
msgstr "Interrompi scansione"

#: admin/class-admin.php:612
msgid "Stopping…"
msgstr "Interruzione…"

#: admin/class-admin.php:613
msgid "(stopped by you before every page was visited)"
msgstr "(interrotta da te prima che tutte le pagine fossero visitate)"

#: admin/class-admin.php:614
msgid "Failed to delete stale cookies."
msgstr "Eliminazione dei cookie obsoleti non riuscita."

#: admin/class-admin.php:615
msgid "Failed to load cookies for stale cleanup."
msgstr "Caricamento dei cookie per la pulizia degli obsoleti non riuscito."

#: admin/class-admin.php:616
msgid "Scanning..."
msgstr "Scansione in corso..."

#: admin/class-admin.php:617 admin/views/cookies.php:86
msgid "Scan Site"
msgstr "Scansiona sito"

#: admin/class-admin.php:618
msgid "Scan failed."
msgstr "Scansione non riuscita."

#. translators: %1$d: number of cookies found by the scan, %2$d: number of pages scanned
#: admin/class-admin.php:620
#, php-format
msgid "Scan complete — %1$d cookies found on %2$d pages"
msgstr "Scansione completata — %1$d cookie trovati su %2$d pagine"

#. translators: %s: machine-readable reason the scan stopped before visiting every page, e.g. "no-new-findings"
#: admin/class-admin.php:622
#, php-format
msgid "(early stop: %s)"
msgstr "(interruzione anticipata: %s)"

#. translators: %d: number of catalogued cookies the latest scan did not observe
#: admin/class-admin.php:624
#, php-format
msgid "%d stale cookie(s) highlighted"
msgstr "%d cookie obsoleti evidenziati"

#. translators: appended to the scan summary when the scan was capped, incremental, early-stopped or degraded, and therefore could not prove that a catalogued cookie is gone.
#: admin/class-admin.php:626
msgid "Scan coverage was incomplete, so no cookie was marked as stale."
msgstr "La copertura della scansione era incompleta, quindi nessun cookie è stato contrassegnato come obsoleto."

#: admin/class-admin.php:629
msgid "The browser scan was saved. Server-header enrichment is still running in the background, so a few more cookies may appear shortly."
msgstr "La scansione del browser è stata salvata. L'arricchimento dagli header lato server è ancora in corso in background, quindi potrebbero comparire altri cookie a breve."

#: admin/class-admin.php:630
msgid "No pages found to scan."
msgstr "Nessuna pagina da scansionare."

#: admin/class-admin.php:631
msgid "Failed to discover pages."
msgstr "Individuazione delle pagine non riuscita."

#: admin/class-admin.php:632
msgid "Scan finished but failed to save results."
msgstr "Scansione completata ma salvataggio dei risultati non riuscito."

#. translators: %1$d: number of cookies an earlier attempt already imported, %2$d: number of pages scanned
#: admin/class-admin.php:637
#, php-format
msgid "Already saved — %1$d cookies on %2$d pages were imported by an earlier attempt. Nothing was saved twice."
msgstr "Già salvato — %1$d cookie su %2$d pagine erano stati importati da un tentativo precedente. Non è stato salvato nulla due volte."

#: admin/class-admin.php:638
msgid "Not saved"
msgstr "Non salvato"

#: admin/class-admin.php:639
msgid "The scan finished but the results could not be saved. Nothing is lost — they are held on the server for a few minutes. Retrying saves them; it does not scan the site again."
msgstr "La scansione è terminata ma i risultati non sono stati salvati. Non è andato perso nulla: restano sul server per qualche minuto. Riprovando li salvi, senza scansionare di nuovo il sito."

#: admin/class-admin.php:640
msgid "The scan finished but the results could not be saved. The capture session is held on the server for a few minutes, so retrying reuses it instead of failing — but this browser has to walk the pages again."
msgstr "La scansione è terminata ma i risultati non sono stati salvati. La sessione di cattura resta sul server per qualche minuto, quindi riprovando la riusa invece di fallire — ma questo browser deve ripercorrere le pagine."

#: admin/class-admin.php:641
msgid "Retry import"
msgstr "Riprova l'importazione"

#: admin/class-admin.php:642
msgid "Retry import (re-scans the site)"
msgstr "Riprova l'importazione (riscansiona il sito)"

#: admin/class-admin.php:643
msgid "Discard"
msgstr "Scarta"

#. translators: %s: clock time the scan session was opened, e.g. "14:32"
#: admin/class-admin.php:647
#, php-format
msgid "A cookie scan session for your account is already open on the server (started at %s). A new scan cannot start until it ends."
msgstr "Sul server è già aperta una sessione di scansione dei cookie per il tuo account (avviata alle %s). Non è possibile avviarne una nuova finché non termina."

#. translators: %1$d: number of cookie observations captured so far, %2$s: clock time of the most recent one
#: admin/class-admin.php:649
#, php-format
msgid "It is capturing right now — %1$d observation(s) so far, the last at %2$s. If one of your other tabs is running a scan, let it finish. Ending the session discards everything it has captured."
msgstr "Sta acquisendo in questo momento — %1$d osservazioni finora, l'ultima alle %2$s. Se una delle tue altre schede sta eseguendo una scansione, lasciala finire. Terminare la sessione scarta tutto ciò che ha acquisito."

#. translators: %s: clock time the scan session last showed any activity
#: admin/class-admin.php:651
#, php-format
msgid "Nothing has reached the server since %s. If none of your tabs is running a scan, the tab that was driving this one is gone. The session will expire on its own in a few minutes, or you can end it now — ending it discards everything it captured."
msgstr "Dalle %s non è arrivato più nulla al server. Se nessuna delle tue schede sta eseguendo una scansione, la scheda che guidava questa non c'è più. La sessione scadrà da sola entro pochi minuti, oppure puoi terminarla adesso — terminarla scarta tutto ciò che ha acquisito."

#: admin/class-admin.php:652
msgid "End this scan and discard its capture"
msgstr "Termina questa scansione e scarta ciò che ha acquisito"

#: admin/class-admin.php:653
msgid "Scan session ended — its capture was discarded. You can start a new scan."
msgstr "Sessione di scansione terminata — ciò che aveva acquisito è stato scartato. Puoi avviare una nuova scansione."

#: admin/class-admin.php:654
msgid "The browser scan could not inspect any page. Make sure the public site is reachable through the WordPress admin origin and that framing is not blocked."
msgstr "La scansione del browser non ha potuto ispezionare alcuna pagina. Verifica che il sito pubblico sia raggiungibile tramite l'origine dell'area di amministrazione di WordPress e che l'inserimento in frame non sia bloccato."

#: admin/class-admin.php:655
msgid "Discovering pages..."
msgstr "Rilevamento delle pagine..."

#: admin/class-admin.php:656
msgid "Enriching with server scan..."
msgstr "Arricchimento con scansione lato server..."

#: admin/class-admin.php:657
msgid "Saving results..."
msgstr "Salvataggio dei risultati..."

#: admin/class-admin.php:658
msgid "No cookies to process."
msgstr "Nessun cookie da elaborare."

#: admin/class-admin.php:659
msgid "No uncategorized cookies to process."
msgstr "Nessun cookie non categorizzato da elaborare."

#: admin/class-admin.php:660
msgid "No cookies could be auto-categorized."
msgstr "Nessun cookie è stato categorizzato automaticamente."

#: admin/class-admin.php:661
msgid "Auto-categorize failed."
msgstr "Categorizzazione automatica non riuscita."

#: admin/class-admin.php:662
msgid "No definitions downloaded yet. Click \"Update Definitions\" to download."
msgstr "Nessuna definizione scaricata. Fare clic su \"Aggiorna definizioni\" per scaricarle."

#: admin/class-admin.php:663
msgid "Could not load definitions status."
msgstr "Impossibile caricare lo stato delle definizioni."

#: admin/class-admin.php:664
msgid "Downloading definitions from GitHub..."
msgstr "Download delle definizioni da GitHub..."

#: admin/class-admin.php:665
msgid "Definitions updated."
msgstr "Definizioni aggiornate."

#: admin/class-admin.php:666
msgid "Update failed."
msgstr "Aggiornamento non riuscito."

#: admin/class-admin.php:667
msgid "Update failed. Check your network connection."
msgstr "Aggiornamento non riuscito. Verificare la connessione di rete."

#: admin/class-admin.php:668
msgid "— Select —"
msgstr "— Seleziona —"

#: admin/class-admin.php:669 admin/views/banner.php:317
msgid "Remove"
msgstr "Rimuovi"

#: admin/class-admin.php:670
msgid "rule(s) incomplete — fill in both pattern and category."
msgstr "regola/e incompleta/e — compilare sia il pattern che la categoria."

#: admin/class-admin.php:671
msgid "Custom rules saved."
msgstr "Regole personalizzate salvate."

#: admin/class-admin.php:672
msgid "Failed to save custom rules."
msgstr "Salvataggio delle regole personalizzate non riuscito."

#: admin/class-admin.php:673
msgid "No templates available."
msgstr "Nessun modello disponibile."

#: admin/class-admin.php:674
msgid "No patterns or cookies in template."
msgstr "Nessun pattern o cookie nel modello."

#: admin/class-admin.php:675
msgid "not found — cookies not added."
msgstr "non trovato — cookie non aggiunti."

#: admin/class-admin.php:676
msgid "Failed to create cookies from template."
msgstr "Creazione dei cookie dal modello non riuscita."

#: admin/class-admin.php:677
msgid "Failed to load templates."
msgstr "Caricamento dei modelli non riuscito."

#: admin/class-admin.php:678
msgid "Shortcode copied!"
msgstr "Shortcode copiato!"

#: admin/class-admin.php:679
msgid "No scan logs available."
msgstr "Nessun log di scansione disponibile."

#: admin/class-admin.php:680
msgid "Failed to download debug log."
msgstr "Impossibile scaricare il log di debug."

#: admin/class-admin.php:681
msgid "Clear all scanner debug logs?"
msgstr "Cancellare tutti i log di debug dello scanner?"

#: admin/class-admin.php:682
msgid "Debug logs cleared."
msgstr "Log di debug cancellati."

#: admin/class-admin.php:683
msgid "Failed to clear debug logs."
msgstr "Impossibile cancellare i log di debug."

#. translators: %s: preset name
#: admin/class-admin.php:688
#, php-format
msgid "Preset applied: %s"
msgstr "Preset applicato: %s"

#: admin/class-admin.php:689
msgid "Failed to load banner settings."
msgstr "Caricamento delle impostazioni del banner non riuscito."

#: admin/class-admin.php:690
msgid "Banner settings saved."
msgstr "Impostazioni del banner salvate."

