#. Plugin Name of the plugin
#: faz-cookie-manager.php admin/views/base.php:71
msgid "FAZ Cookie Manager"
msgstr "FAZ Cookie Manager"

#. Plugin URI of the plugin
#: faz-cookie-manager.php
msgid "https://github.com/fabiodalez-dev/faz-cookie-manager"
msgstr "https://github.com/fabiodalez-dev/faz-cookie-manager"

#. Description of the plugin
#: faz-cookie-manager.php
msgid "A comprehensive GDPR/CCPA cookie consent manager with built-in cookie scanner, local consent logging, Google Consent Mode v2, and IAB TCF v2.3 support."
msgstr "Un gestore completo del consenso cookie conforme a GDPR/CCPA con scanner cookie integrato, registrazione locale del consenso, Google Consent Mode v2 e supporto IAB TCF v2.3."

#. Author of the plugin
#: faz-cookie-manager.php
msgid "Fabio D'Alessandro"
msgstr "Fabio D'Alessandro"

