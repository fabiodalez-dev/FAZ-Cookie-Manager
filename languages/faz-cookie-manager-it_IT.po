msgstr "altre regioni: banner nascosto, cookie consentiti"

#: admin/views/setup.php:416
msgid "EU / EEA, United Kingdom (default)"
msgstr "UE / SEE, Regno Unito (predefinito)"

#: admin/views/setup.php:417
