{
  "$schema": "../schemas/ruleset.schema.json",
  "id": "appi-japan",
  "version": "1.0.0",
  "display_name": "APPI — Japan (PPC)",
  "law_references": [
    "APPI (riv. 2022)"
  ],
  "applies_to": {
    "countries": [
      "JP"
    ]
  },
  "model": "hybrid",
  "native_lang": "ja",
  "official_resources_url": [
    "https://www.ppc.go.jp/"
  ],
  "signals": {
    "tcf_v22": false,
    "gpc_honored": false,
    "gpc_required": false,
    "dnt_honored": false,
    "cmv2": {
      "ad_storage": "denied",
      "analytics_storage": "denied",
      "ad_user_data": "denied",
      "ad_personalization": "denied",
      "personalization_storage": "denied",
      "functionality_storage": "granted",
      "security_storage": "granted"
    }
  },
  "ui": {
    "equal_weight_buttons": true,
    "donotsell_link_required": false,
    "sensitive_separate_optin": true,
    "revisit_widget_required": true,
    "default_categories": {
      "necessary": "granted-locked",
      "functional": "denied",
      "analytics": "denied",
      "marketing": "denied",
      "profiling": "denied"
    }
  },
  "cross_border_notes": null,
  "_meta": {
    "behavior_review_date": "2026-05-20",
    "next_review_due": "2027-05-20",
    "notes": "Opt-out non-sensitive + opt-in sensitive."
  }
}
